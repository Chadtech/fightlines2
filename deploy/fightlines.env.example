FIGHTLINES_ENV=production
FIGHTLINES_ADDR=127.0.0.1:8080
FIGHTLINES_FRONTEND_DIR=/opt/fightlines/public
FIGHTLINES_MAP_DIR=/opt/fightlines/maps
FIGHTLINES_GAME_LOG_DIR=/var/lib/fightlines/game-logs
FIGHTLINES_SERVER_LOG_DIR=/var/log/fightlines
# Leave FIGHTLINES_SEED unset so each startup uses fresh operating-system randomness.
